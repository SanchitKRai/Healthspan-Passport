# OpenRouter API Key for extraction and AI Companion
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: chatbot model only; does not change extraction models.
# Defaults to the existing verified extraction primary model.
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3.5-lightning

# Comma-separated allowed origins for CORS in production
CORS_ORIGINS=https://healthspan-passport.vercel.app,http://localhost:3000
